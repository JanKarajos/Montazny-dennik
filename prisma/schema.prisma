generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String           @id @default(uuid()) @db.Uuid
  email                  String           @unique
  password               String
  requiresPasswordChange Boolean          @default(true)
  name                   String
  roleId                 String           @db.Uuid
  role                   Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissions            Permission[]     @relation("UserPermissions")
  createdAt              DateTime         @default(now())
  workLogs               WorkLog[]
  completedProjects      Project[]        @relation("ProjectCompletedBy")
  uploadedProtocols      SignedProtocol[] @relation("ProtocolUploadedBy")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  users       User[]
  permissions Permission[] @relation("RolePermissions")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  createdAt   DateTime @default(now())
  roles       Role[]   @relation("RolePermissions")
  users       User[]   @relation("UserPermissions")
}

enum DiaryType {
  ASSEMBLY
  SERVICE
}

enum CompletionMethod {
  DIGITAL_SIGNATURE
  PAPER_PROTOCOL
  WITHOUT_SIGNATURE
}

model Project {
  id                String            @id @default(uuid()) @db.Uuid
  type              DiaryType         @default(ASSEMBLY)
  projectNumber     String
  name              String
  createdAt         DateTime          @default(now())
  employeeSignature String?
  employeeSignedAt  DateTime?
  customerSignature String?
  customerSignedAt  DateTime?
  completedAt       DateTime?
  completionMethod  CompletionMethod?
  completedById     String?           @db.Uuid
  completedBy       User?             @relation("ProjectCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  signedProtocol    SignedProtocol?
  persons           ProjectPerson[]
  workLogs          WorkLog[]

  // Číslo montážnej zákazky je unikátne cez čiastočný index
  // "Project_assembly_projectNumber_key" (WHERE type = 'ASSEMBLY') v migrácii
  // 20261111090000_service_number_not_unique – Prisma čiastočné indexy nevie popísať.
  // Číslo servisnej zákazky sa môže opakovať.
  @@index([type, projectNumber])
  @@index([type, createdAt])
}

model WorkLog {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  userId            String?  @db.Uuid
  description       String
  date              DateTime
  startTime         DateTime
  endTime           DateTime
  durationInMinutes Int
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([userId])
}

model SignedProtocol {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @unique @db.Uuid
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedAt   DateTime @default(now())
  uploadedById String?  @db.Uuid

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("ProtocolUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
}

// Zoznam osôb (montéri, servisní technici), z ktorého sa vyberajú osoby k zákazke.
model Person {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
}

// Osoby, ktoré boli na montáži alebo servise. Meno sa ukladá priamo, aby sa dalo
// dopísať aj mimo zoznamu a aby ho neskoršia zmena zoznamu nezmenila.
model ProjectPerson {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}
